{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://dev-atlas-vlw3.onrender.com/api/auth/:path*"
    },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/notes/:path*", "destination": "/index.html" },
    { "source": "/dsa", "destination": "/index.html" },
    { "source": "/dsa/:path*", "destination": "/index.html" },
    { "source": "/books", "destination": "/index.html" },
    { "source": "/books/:path*", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/hero-night.webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/notes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
